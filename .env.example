# Bu dosya kendiliğinden yüklenmez. Değişkenleri terminal veya bulut ayarlarından tanımlayın.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Canlı ortam için: DJANGO_DEBUG=false ve güvenli DJANGO_SECRET_KEY zorunludur.
# DATABASE_URL: güvenli ortam ayarlarından PostgreSQL bağlantısını girin.
# DJANGO_CSRF_TRUSTED_ORIGINS: HTTPS alan adlarını virgülle ayırın.
